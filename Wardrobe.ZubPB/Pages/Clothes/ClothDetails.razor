@page "/clothesDetails/{id}";
@using WardrobeInventory.Models;
@inject HttpClient _client;
@inject IJSRuntime _jsrt;
@inject NavigationManager _nm;

<h3>Delete Cloth</h3>

<div>
    @if (Cloth != null && Cloth.Id != 0)
    {
        <dl class="row" style="max-width: 50%">
            <dt class="col-sm-2 mb-2">#:</dt>
            <dd class="col-sm-10 mb-2">@Cloth!.Id</dd>
            <dt class="col-sm-2 mb-2">Name:</dt>
            <dd class="col-sm-10 mb-2">@Cloth.Name</dd>
            <dt class="col-sm-2 mb-2">Category:</dt>
            <dd class="col-sm-10 mb-2">@Cloth.Category!.Name</dd>
            @if (Cloth.Sets != null)
            {
                <dt class="col-sm-2 mb-2">Sets:</dt>
                
                    <dd class="col-sm-10">
                        <dl class="row">
                        @foreach(Set set in Cloth.Sets)
                        {
                            <dd class="col-sm-6">
                                <span class="me-2">@set.Name:</span>
                                <img src="@set.UpperCloth!.Img" class="index-img" />
                                <img src="@set.LowerCloth!.Img" class="index-img" />
                                <img src="@set.Shoes!.Img" class="index-img" />
                            </dd>
                        }

                        </dl>
                </dd>
            }
            <dt class="col-sm-2"></dt>
            <dd class="col-sm-10">
                <button type="button" class="btn btn-success me-2" @onclick="@Edit">Edit</button>
                <button type="button" class="btn btn-warning text-light" @onclick="@Cancel">Cancel</button>
            </dd>
        </dl>
    }
</div>

@code {
    [Parameter]
    public string? Id { get; set; }

    private Cloth? Cloth = new();

    protected override async Task OnInitializedAsync()
    {
        HttpResponseMessage? rm = await _client.GetAsync($"api/cloth/getwithsets/{Id}");
        rm.EnsureSuccessStatusCode();
        if (rm.StatusCode == System.Net.HttpStatusCode.OK) Cloth = await rm.Content.ReadFromJsonAsync<Cloth>();

        if (Cloth == null || Cloth.Id == 0) _nm.NavigateTo("/clothes");

        List<Set> sets = [];
        foreach(Set s in Cloth!.Sets!)
        {
            rm = await _client.GetAsync($"api/set/get/{s.Id}");
            rm.EnsureSuccessStatusCode();
            Set? set = await rm.Content.ReadFromJsonAsync<Set>();
            sets.Add(set!);
        }

        Cloth.Sets = sets;
    }

    private void Edit() => _nm.NavigateTo($"/clothesEdit/{Id}");

    private void Cancel() => _nm.NavigateTo("/clothes");
}