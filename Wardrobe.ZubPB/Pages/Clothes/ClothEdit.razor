@page "/clothesEdit/{id}";
@using WardrobeInventory.Models;
@inject HttpClient _client;
@inject IJSRuntime _jsrt;
@inject NavigationManager _nm;

<h3>Edit Cloth</h3>

<div>
    <form @onsubmit="@Save">
        <dl class="row" style="max-width: 50%">
            <dt class="col-sm-2 mb-2">Name:</dt>
            <dd class="col-sm-10 mb-2">
                <input type="text" min="3" max="30" @bind="@Cloth.Name" />
            </dd>
            <dt class="col-sm-2 mb-4">Category:</dt>
            <dd class="col-sm-10 mb-2">
                <select @bind="@Cloth.CategoryId">
                    @foreach (Category c in Categories!)
                    {
                        if (c.Id == Cloth.CategoryId)
                        {
                            <option selected="selected" value="@c.Id">@c.Name</option>
                        }
                        else
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    }
                </select>
            </dd>
            <dt class="col-sm-2 mb-2 pt-3">Image:</dt>
            <dd class="col-sm-10 d-inline mb-4">
                <div class="d-inline">
                    <InputFile type="file" OnChange="LoadFile" class="" accept=".jpg,.png"></InputFile>
                    <img src="@UploadedImg" class="index-img me-3" />
                |
                    <label for="@Cloth.Img" class="ms-3 me-2">Current image:</label>
                    <img src="@Cloth.Img" class="index-img" />
                </div>
            </dd>
            <dt class="col-sm-2"></dt>
            <dd class="col-sm-10">
                <button type="submit" class="btn btn-primary me-2" value="Save">Save</button>
                <button type="button" class="btn btn-warning text-light" value="Cancel" @onclick="@Cancel">Cancel</button>
            </dd>
        </dl>
    </form>

</div>

@code {
    [Parameter]
    public string? Id { get; set; }

    private Cloth Cloth = new();
    private List<Category>? Categories = [];
    private IBrowserFile? BrowserFile { get; set; }
    private ClothImageFile? ImgFile { get; set; }
    private Guid InputFileId = Guid.NewGuid();
    private string? FileExt { get; set; }
    private string? UploadedImg { get; set; }

    protected override async Task OnInitializedAsync()
    {
        HttpResponseMessage? rm = await _client.GetAsync($"api/cloth/get/{Id}");
        rm.EnsureSuccessStatusCode();
        if (rm.StatusCode == System.Net.HttpStatusCode.OK) Cloth = await rm.Content.ReadFromJsonAsync<Cloth>();

        if (Cloth == null || Cloth.Id == 0) _nm.NavigateTo("/clothes");

        rm = await _client.GetAsync("api/category");
        rm.EnsureSuccessStatusCode();
        Categories = await rm.Content.ReadFromJsonAsync<List<Category>>();
    }

    protected async void LoadFile(InputFileChangeEventArgs e)
    {
        if (e.File.Size < 200000)
        {
            BrowserFile = e.File;
            FileExt = BrowserFile.Name.Substring(BrowserFile.Name.LastIndexOf('.') + 1, BrowserFile.Name.Length - BrowserFile.Name.LastIndexOf('.') - 1);
            IBrowserFile file = BrowserFile;
            byte[] imgBytes = new byte[file.Size];
            await using (MemoryStream ms = new(imgBytes))
            {
                await file.OpenReadStream().CopyToAsync(ms);
                UploadedImg = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
                await InvokeAsync(StateHasChanged);
            }
        }
        else
        {
            InputFileId = Guid.NewGuid();
            FileExt = string.Empty;
        }
    }

    protected async Task Save()
    {
        HttpResponseMessage? rm = await _client.GetAsync($"api/category/get/{Cloth.CategoryId}");
        Category? category = await rm.Content.ReadFromJsonAsync<Category>();

        if (BrowserFile != null) Cloth.Img = $"img/test/{category!.Name}/{Cloth.Name}.{FileExt}";

        rm = await _client.PutAsJsonAsync($"api/cloth/update/{Id}", Cloth);
        bool updated = await rm.Content.ReadFromJsonAsync<bool>();

        if (updated)
        {
            if (BrowserFile != null)
            {
                if (BrowserFile != null)
                {
                    try
                    {
                        using (MemoryStream memoryStream = new MemoryStream())
                        {
                            await BrowserFile!.OpenReadStream(100000).CopyToAsync(memoryStream);
                            var smallFileByteArray = memoryStream.ToArray();

                            ImgFile = new($"{Directory.GetCurrentDirectory()}/wwwroot/{Cloth.Img}", smallFileByteArray);
                            HttpResponseMessage? trm = await _client.PostAsJsonAsync("api/cloth/upload", ImgFile);
                        }
                    }
                    catch
                    {
                        await _jsrt.InvokeVoidAsync("alert", "Cloth Updated Successfully but Image could note be uploaded");
                        _nm.NavigateTo("/clothes");
                    }
                }
            }
            await _jsrt.InvokeVoidAsync("alert", "Cloth Updated Successfully");
            _nm.NavigateTo("/clothes");
        }
        else await _jsrt.InvokeVoidAsync("alert", "Impossible to add new cloth. Are you sure all field are filled?");
    }

    protected void Cancel() => _nm.NavigateTo("/clothes");
}