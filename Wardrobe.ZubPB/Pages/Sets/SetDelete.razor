@page "/setsDelete/{id}";
@using WardrobeInventory.Models;
@inject HttpClient _client;
@inject IJSRuntime _jsrt;
@inject NavigationManager _nm;

<h3>Delete Set</h3>

<div>
    @if(Set != null)
    {
        <dl class="row" style="max-width: 50%">
            <dt class="col-sm-2 mb-5">Name:</dt>

            <dd class="col-sm-10">@Set.Name</dd>
            <dt class="col-sm-2 mb-5 mt-3">Upper Cloth:</dt>
            <dd class="col-sm-10">@Set.UpperCloth!.Name <img src="@Set.UpperCloth.Img" class="index-img ms-3" /></dd>

            <dt class="col-sm-2 mb-5 mt-3">Lower Cloth:</dt>
            <dd class="col-sm-10 mb-2">@Set.LowerCloth!.Name <img src="@Set.LowerCloth.Img" class="index-img ms-3" /></dd>

            <dt class="col-sm-2 mb-5 mt-35">Shoes:</dt>
            <dd class="col-sm-10">@Set.Shoes!.Name <img src="@Set.Shoes.Img" class="index-img ms-3" /></dd>

            <dt class="col-sm-2"></dt>
            <dd class="col-sm-10">
                <button type="button" class="btn btn-danger me-2" @onclick="@Delete">Delete</button>
                <button type="button" class="btn btn-warning text-light" @onclick="@Cancel">Cancel</button>
            </dd>
        </dl>
    }
</div>

@code {
    [Parameter]
    public string? Id { get; set; }
    private Set? Set { get; set; }

    protected override async Task OnInitializedAsync()
    {
        HttpResponseMessage? rm = await _client.GetAsync($"api/set/get/{Id}");
        rm.EnsureSuccessStatusCode();
        Set = await rm.Content.ReadFromJsonAsync<Set>();
    }

    protected async Task Delete()
    {
        HttpResponseMessage? rm = await _client.DeleteAsync($"api/set/delete/{Id}");
        rm.EnsureSuccessStatusCode();
        if (await rm.Content.ReadFromJsonAsync<bool>())
        {
            await _jsrt.InvokeVoidAsync("alert", "Set Successfully Deleted.");
            _nm.NavigateTo("/sets");
        }
        else await _jsrt.InvokeVoidAsync("alert", "Impossible to delete the set.");
    }

    protected void Cancel() => _nm.NavigateTo("/sets");
}